NODE_ENV=development
PORT=4000

# Neon Postgres connection string (never pauses - use the pooled connection string)
# Get this from: neon.tech → Your Project → Connection Details → Pooled connection
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-XXXX.region.aws.neon.tech/neondb?sslmode=require

JWT_ACCESS_SECRET=change_me_access_32_chars_minimum________________________________
JWT_REFRESH_SECRET=change_me_refresh_32_chars_minimum_______________________________
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_DOMAIN=localhost
REFRESH_COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here
